// Nyquist Plot
clear;
clc;

// Define Laplace variable
s = %s;

// Given values
T1 = 5;
T2 = 10;
K = 1;

// Transfer function
den = (T1*s + 1)*(T2*s + 1);
GH = syslin('c', K, den);

disp(GH, "The given transfer function G(s)H(s) =");

// Plot Nyquist diagram
nyquist(GH, 0.001, 1000);

xgrid();

a = gca();
a.clip_state = "on";
a.data_bounds = [-0.3 -0.8; 1.3 0.8];
a.box = "on";
