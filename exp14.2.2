
clc;
clear;
mode(0);

// Define state-space matrices
A = [0 1;
    -25 -4];

B = [1 1;
     0 1];

C = [1 0;
     0 1];

D = [0 0;
     0 0];

// Create state-space model
H = syslin('c',A,B,C,D);

// Display state-space model
disp(H,"The given state model matrices are");

disp(A,"A =");
disp(B,"B =");
disp(C,"C =");
disp(D,"D =");

// Convert state-space model into transfer functions
G = clean(ss2tf(H));

// Display transfer functions
disp(G,"The obtained transfer functions are");
