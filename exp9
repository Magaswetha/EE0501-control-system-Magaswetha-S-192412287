clear;
clc;
close(winsid());

// Define the Laplace variable
s = %s;

// Define the frequency range
omega = logspace(-1, 3, 1000);

// Define the transfer function
G = syslin('c', 10, 0.05*s^3 + 0.6*s^2 + s);

// Display the transfer function
disp("The given transfer function G(s) = ");
disp(G);

// Calculate the frequency response
H = horner(G, %i*omega);

// Calculate real and imaginary parts
real_part = real(H);
imag_part = imag(H);

// Plot the polar plot
scf();
plot(real_part, imag_part);
xgrid();

xtitle("Polar Plot of G(s)", "Real Part", "Imaginary Part");

// Mark the origin
plot(0, 0, 'ro');
