
clear;
clc;
mode(0);

// Define state-space matrices
A = [0 1;
    -0.4 -1.3];

B = [0;
     1];

C = [0.8 1];

D = [0];

// System 1
G1 = syslin('c',A,B,C,D);

disp("State space model 1:");
ssprint(G1);

// System 2 (Dual system)
G2 = syslin('c',A',C',B',D);

disp("State space model 2:");
ssprint(G2);

// System 1 - Controllability
Cc1 = cont_mat(A,B);

disp(Cc1,"State controllability matrix 1 =");
disp(det(Cc1),"det(Cc1) =");

if (rank(Cc1) == size(A,1)) then
    disp("The given system 1 is completely controllable");
else
    disp("The given system 1 is not completely controllable");
end

// System 1 - Observability
Ob1 = obsv_mat(A,C);

disp(Ob1,"Observability matrix 1 =");
disp(det(Ob1),"det(Ob1) =");

if (rank(Ob1) == size(A,1)) then
    disp("The given system 1 is completely observable");
else
    disp("The given system 1 is not completely observable");
end

// System 2 - Controllability
Cc2 = cont_mat(A',C');

disp(Cc2,"State controllability matrix 2 =");
disp(det(Cc2),"det(Cc2) =");

if (rank(Cc2) == size(A,1)) then
    disp("The given system 2 is completely controllable");
else
    disp("The given system 2 is not completely controllable");
end

// System 2 - Observability
Ob2 = obsv_mat(A',B');

disp(Ob2,"Observability matrix 2 =");
disp(det(Ob2),"det(Ob2) =");

if (rank(Ob2) == size(A,1)) then
    disp("The given system 2 is completely observable");
else
    disp("The given system 2 is not completely observable");
end

// Transfer function
Htf = ss2tf(G1);

disp(Htf,"Reduced transfer function =");

// Eigenvalues
e = spec(A);

disp(e,"Eigen values =");

// Characteristic polynomial
P = poly(e,'s');

disp(P,"Actual denominator (characteristic polynomial) =");
