// Nyquist Plot
clear;
clc;
close("all");  // Close all graphic windows

// Define Laplace variable
s = %s;

// Given transfer function
G = syslin('c', 20*(s^2 + s + 0.5), s*(s+1)*(s+10));

disp(G, "The given transfer function G(s) =");

// Configure plot
a = gca();
a.clip_state = "on";

// Nyquist plot
nyquist(G, 0.001, 1000);

xgrid();

// Set axis limits
a = gca();
a.data_bounds = [-1 -3; 3 3];
a.box = "on";
